static func kind_of(value: Variant) -> String:
    match typeof(value):
        TYPE_NIL:
            return "null"
        TYPE_BOOL:
            return "bool"
        TYPE_INT, TYPE_FLOAT:
            return "number"
        TYPE_STRING, TYPE_STRING_NAME:
            return "string"
        TYPE_ARRAY:
            return "list"
        TYPE_DICTIONARY:
            return "dict"
    return type_string(typeof(value))

