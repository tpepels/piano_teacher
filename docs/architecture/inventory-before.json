  "review_findings": {
    "backend": [
      "Mixed session transitions, snapshot projection, score artifacts, MIDI lifecycle and Listen jobs in PracticeEngine",
      "music/fingering.types edge is typing-only; do not mislabel it a runtime cycle",
      "Renderer-oriented import facade used unnecessarily by library_health and preprocessing_cache",
      "Unreachable rewind-layout branch and unused engine.score; distinguish active source/db/HTTP API contracts"
    ],
    "ui": [
      "main.gd construction/polling/navigation/presentation/transport/resource lifetimes mixed",
      "Screens own mutable controls through main aliases; Library construction also constructed Settings",
      "Picker route/poll suppression mismatch and missing MIDI-start guard",
      "Failed lesson request identity can suppress retry",
      "Old UI harness aliases have drifted from current owners"
    ],
    "native": [
      "Source index/geometry/cache, density fitting, note/context drawing and annotation editing mixed",
      "Component borrowers require explicit timeline and viewport rebinding at lifetime boundaries",
      "Source visibility must be shared between music and instructional layers without callbacks"
    ],
    "verification": [
      "Runtime lazy cycles among raster_matching/phase3_pixels/symbol_pixel_proof and feature_pixels/connector_pixels",
      "Feature measurement families and source coverage acceptance mixed",
      "Audit capture, process identity, checkpoint, case/proof execution and publication in one CLI",
      "Extracted worker modules must participate in verification input hashing"
    ],
    "provider_adapter": [
      "117-line first-party Node bridge owns one inference request and fixed physical constraints; CPU threads bounded and ONNX sessions released in finally; cohesive adapter, no refactor needed"
    ]
  }
}
