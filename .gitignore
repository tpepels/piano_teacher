# Local Python tooling and editable installs.
.venv/
.rubricnet-venv/
__pycache__/
.pytest_cache/
*.py[cod]
*.egg-info/
.coverage
htmlcov/

# Personal sessions, diagnostics and generated distributables.
playtest-results/
notation-check-results/
dist/
build/

# Godot regenerates these editor/import/shader caches per machine.
godot/.godot/

# Public-domain count-in voice assets are cached by the launcher.
godot/assets/countin/*.ogg
godot/assets/countin/*.ogg.part

# Ignore newly generated GDScript resource UIDs in local working trees.
# Existing tracked UID files remain tracked; explicitly force-add a new
# source UID when stable cross-checkout uid:// references require it.
godot/**/*.gd.uid

# Installed offline-fingering dependencies (recreated by setup-fingering.sh).
piano_teacher/fingering/lumikey_runtime/node_modules/

# Machine-specific native bridge build outputs (recreated by build-inprocess.sh).
godot/native/build-inputs.json
godot/native/python-abi.txt
godot/native/piano_bridge.gdextension
godot/native/piano_bridge.gdextension.uid

# Local Codex planning scratch files; not product documentation.
docs/superpowers/
